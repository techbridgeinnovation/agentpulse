{
  "name": "techbridge-agentpulse",
  "version": "0.3.0",
  "description": "Records what an AI agent spent, from inside the agent's own process, for Agent Pulse.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techbridgeinnovation/agentpulse.git",
    "directory": "typescript"
  },
